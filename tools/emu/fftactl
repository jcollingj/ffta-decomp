#!/usr/bin/env python3
"""CLI control for FFTA running in SkyEmu's headless HTTP server.

Usage:
  fftactl start [rom]        Launch headless emulator (default build/ffta.gba)
  fftactl stop               Kill the emulator
  fftactl ping               Check server is up
  fftactl status             Show loaded ROM, pause state, and active inputs
  fftactl checkpoint save|load PATH  Durable file checkpoint (never overwrite)
  fftactl screen [out.png]   Save screenshot (default screen.png)
  fftactl press BTN [N]      Hold button N frames (default 5), then release
  fftactl mash BTN [N]       Repeatedly tap button for N total frames
                             (default 600; ~2 taps/sec of game time)
                             BTN: A B L R Up Down Left Right Start Select
  fftactl step [N]           Advance N frames (default 1)
  fftactl run                Unpause, run at 1x realtime
  fftactl read ADDR [LEN]    Read LEN bytes (default 4) at hex ADDR
  fftactl write ADDR=HH ...  Write byte(s), e.g. write 02000000=ff
  fftactl state save|load N  Save/load state slot N
"""
import subprocess
import json
import os
import pathlib
import signal
from datetime import datetime, timezone
import sys
import time
import urllib.parse
import urllib.request

REPO = pathlib.Path(__file__).resolve().parents[2]
PORT = int(os.environ.get("FFTA_PORT", "8080"))
BASE = f"http://localhost:{PORT}"
SKYEMU = os.environ.get("SKYEMU", "/Applications/SkyEmu.app/Contents/MacOS/SkyEmu")
DEFAULT_ROM = str(REPO / "build/ffta.gba")
BUTTONS = {"A", "B", "L", "R", "Up", "Down", "Left", "Right", "Start", "Select"}
SESSION = REPO / "logs" / f"emulator-{PORT}.json"


def frames(value):
    n = int(value)
    if not 1 <= n <= 36000:
        raise ValueError("frame count must be between 1 and 36000")
    return n


def press(button, count):
    if button not in BUTTONS:
        raise ValueError(f"invalid button: {button}")
    try:
        get(f"/input?{button}=1")
        get(f"/step?frames={count}")
    finally:
        get(f"/input?{button}=0")


def request(path, binary=False):
    with urllib.request.urlopen(f"{BASE}{path}", timeout=30) as r:
        data = r.read()
    return data if binary else data.decode().strip("\x00 \r\n")


def get(path, binary=False):
    active = REPO / 'logs' / f'clip-active-{PORT}.json'
    if active.exists():
        if path == '/run' or path.startswith('/load?'):
            raise ValueError('stop clip recording before running live or restoring a state')
        if path.startswith('/input?') and any(x in urllib.parse.unquote(path) for x in
                                              ('Restore State', 'Reset Game')):
            raise ValueError('stop clip recording before restoring or resetting')
        if path == '/step' or path.startswith('/step?'):
            from clip_recording import advance
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(path).query)
            return advance(active, int(query.get('frames', ['1'])[0]), request)
    return request(path, binary=binary)


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return 1
    cmd, rest = args[0], args[1:]
    if cmd in ('start', 'stop') and (REPO / 'logs' / f'clip-active-{PORT}.json').exists():
        raise ValueError('stop or abort clip recording before changing emulator sessions')

    if cmd == "start":
        rom = str(pathlib.Path(rest[0] if rest else DEFAULT_ROM).resolve())
        if any(pathlib.Path(rom).is_relative_to(root.resolve()) for root in
               (REPO / "checkpoints/baselines", REPO / "backups")):
            raise ValueError("protected baseline: use baseline prepare to create a working copy")
        if not pathlib.Path(rom).is_file():
            raise ValueError(f"ROM does not exist: {rom}")
        try:
            status = json.loads(get("/status"))
        except OSError:
            status = None
        if status is not None:
            loaded = pathlib.Path(status["rom-path"])
            if not loaded.is_absolute():
                loaded = REPO / loaded
            if not status["rom-loaded"] or loaded.resolve() != pathlib.Path(rom):
                raise ValueError("port is already in use by a different ROM/session")
            print(f"emulator already running with {rom}")
            return 0
        SESSION.parent.mkdir(parents=True, exist_ok=True)
        with open(SESSION.with_suffix(".log"), "ab") as log:
            proc = subprocess.Popen([SKYEMU, "http_server", str(PORT), rom],
                                    stdout=log, stderr=log, start_new_session=True)
        for _ in range(50):
            time.sleep(0.2)
            if proc.poll() is not None:
                break
            try:
                status = json.loads(get("/status"))
                if status["rom-loaded"] and pathlib.Path(status["rom-path"]).resolve() == pathlib.Path(rom):
                    SESSION.write_text(json.dumps({"pid": proc.pid, "rom": rom,
                                                  "executable": SKYEMU}))
                    print(f"emulator up on :{PORT} with {rom}")
                    return 0
            except OSError:
                pass
        if proc.poll() is None:
            proc.terminate()
        print("emulator failed to start", file=sys.stderr)
        return 1
    if cmd == "stop":
        if not SESSION.is_file():
            raise ValueError("session was not launched by this controller; refusing broad process termination")
        session = json.loads(SESSION.read_text())
        pid = session["pid"]
        command = subprocess.run(["ps", "-p", str(pid), "-o", "command="],
                                 capture_output=True, text=True).stdout.strip()
        expected = f'{session["executable"]} http_server {PORT} {session["rom"]}'
        if command != expected:
            raise ValueError("owned emulator process no longer matches; refusing to signal PID")
        os.kill(pid, signal.SIGTERM)
        SESSION.unlink()
        return 0
    if cmd == "ping":
        print(get("/ping"))
        return 0
    if cmd == "status":
        print(json.dumps(json.loads(get("/status")), indent=2))
        return 0
    if cmd == "checkpoint":
        if len(rest) != 2 or rest[0] not in ("save", "load"):
            raise ValueError("usage: fftactl checkpoint save|load PATH")
        op, name = rest
        path = pathlib.Path(name).resolve()
        if op == "save":
            if path.exists():
                raise ValueError("checkpoint already exists; choose a new name")
            path.parent.mkdir(parents=True, exist_ok=True)
        elif not path.is_file():
            raise ValueError("checkpoint file does not exist")
        result = get(f"/{op}?" + urllib.parse.urlencode({"path": str(path)}))
        if result != "ok":
            raise RuntimeError(f"checkpoint {op} failed: {result}")
        print(path)
        return 0
    if cmd == "screen":
        out = rest[0] if rest else "screen.png"
        with open(out, "wb") as f:
            f.write(get("/screen", binary=True))
        print(out)  # Observing must not advance the game.
        return 0
    if cmd == "press":
        btn, count = rest[0], frames(rest[1]) if len(rest) > 1 else 5
        press(btn, count)
        get("/step")
        print("ok")
        return 0
    if cmd == "mash":
        btn = rest[0]
        total = frames(rest[1]) if len(rest) > 1 else 600
        done = 0
        while done < total:
            held = min(8, total - done)
            press(btn, held)
            done += held
            released = min(22, total - done)
            if released:
                get(f"/step?frames={released}")
                done += released
        print(f"mashed {btn} for {done} frames")
        return 0
    if cmd == "step":
        n = frames(rest[0]) if rest else 1
        print(get(f"/step?frames={n}"))
        return 0
    if cmd == "run":
        print(get("/run"))
        return 0
    if cmd == "read":
        addr = int(rest[0], 16)
        length = int(rest[1]) if len(rest) > 1 else 4
        q = "&".join(f"addr={addr + i:08x}" for i in range(length))
        print(get(f"/read_byte?{q}"))
        return 0
    if cmd == "write":
        q = "&".join(rest)
        print(get(f"/write_byte?{q}"))
        return 0
    if cmd == "state":
        op, slot = rest[0], rest[1] if len(rest) > 1 else "0"
        if op not in ("save", "load") or slot not in ("0", "1", "2", "3"):
            raise ValueError("usage: fftactl state save|load SLOT (0-3)")
        name = f"{'Capture' if op == 'save' else 'Restore'} State {slot}"
        try:
            get(f"/input?{urllib.parse.quote(name)}=1")
            get("/step")
        finally:
            get(f"/input?{urllib.parse.quote(name)}=0")
        get("/step")
        print("ok")
        return 0
    print(f"unknown command: {cmd}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    started = time.monotonic()
    result = 1
    try:
        result = main()
    except (ValueError, IndexError, OSError, RuntimeError) as exc:
        print(f"fftactl: {exc}", file=sys.stderr)
    finally:
        log = REPO / "logs/actions.jsonl"
        log.parent.mkdir(parents=True, exist_ok=True)
        with log.open("a") as f:
            f.write(json.dumps({"utc": datetime.now(timezone.utc).isoformat(),
                                "port": PORT, "args": sys.argv[1:], "exit_code": result,
                                "seconds": round(time.monotonic() - started, 3)}) + "\n")
    sys.exit(result)
